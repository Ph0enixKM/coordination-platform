# Lokalnie: .env.local. Na Cloudflare zmienne Resend ustawia się w Workerze
# (`npx wrangler secret put RESEND_API_KEY` albo w panelu: Settings > Variables).

# Resend (formularz kontaktowy w /api/contact)
RESEND_API_KEY=
# Nadawca na zweryfikowanej domenie, np. "Coordination <formularz@coordination.pl>"
RESEND_FROM_EMAIL=
# Skrzynka, na którą trafiają wiadomości z formularza
CONTACT_EMAIL=kontakt@coordination.pl

# Bezwzględny adres strony w metadanych (OG image, canonical, sitemap).
# Pusty = coordination.pl. Przed przepięciem domeny: adres *.workers.dev.
# Wchodzi do strony przy buildzie, więc musi być ustawiony tam, gdzie leci build.
NEXT_PUBLIC_SITE_URL=

# Kod dostępu do panelu /admin (długi, losowy). Na Cloudflare:
# `npx wrangler secret put ADMIN_CODE`.
ADMIN_CODE=
