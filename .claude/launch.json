{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "dev-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:preview"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "worker-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8787",
        "--test-scheduled",
        "--var",
        "ADMIN_CODE:local-test-code"
      ],
      "port": 8787
    }
  ]
}
