{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coordination-website",
  // Client's Cloudflare account (we work on it as an invited member).
  "account_id": "bcd7c6b524e41e2fb2a20391294089aa",
  // CONTACT_EMAIL and RESEND_FROM_EMAIL are set in the dashboard; without this
  // every deploy would delete variables that are not listed here.
  "keep_vars": true,
  // Serves /media and /api/latest-post without Next.js, then hands the rest to
  // the OpenNext Worker in .open-next/worker.js.
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext calls back into the Worker itself; must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "coordination-website"
    }
  ],
  // next/image optimization through Cloudflare Images.
  "images": {
    "binding": "IMAGES"
  },
  // Blog posts. `database_id` comes from `npx wrangler d1 create coordination`.
  // Schema lives in migrations/ (`npm run db:migrate:remote`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coordination",
      "database_id": "d499b0a7-289c-4825-a8b0-78908b173a0a",
      "migrations_dir": "migrations"
    },
    {
      // The same database, for OpenNext's page cache tags: a save in /admin
      // records there which cached pages went stale. OpenNext creates its
      // `revalidations` table on deploy.
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "coordination",
      "database_id": "d499b0a7-289c-4825-a8b0-78908b173a0a"
    }
  ],
  // Uploaded blog images (already converted to WebP), served by /media/[...key].
  // KV rather than R2: R2 needs a card on the account, KV is in the free plan
  // and its 25 MiB value limit is far above a 1920px WebP.
  // `id` comes from `npx wrangler kv namespace create coordination-media`.
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "619c1e959bb841e7b37e10601b8adda6"
    },
    {
      // Rendered pages (HTML and RSC payload), see open-next.config.ts.
      // `id` comes from `npx wrangler kv namespace create coordination-page-cache`.
      "binding": "NEXT_INC_CACHE_KV",
      "id": "33bb3cadffe74ba2b2118eda9c7f42e0"
    }
  ],
  // Brings posts dated in the future onto the cached pages once they are out
  // (`scheduled` in worker.ts).
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
